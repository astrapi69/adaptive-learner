# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
.venv/
venv/

# Mutation testing
mutants/
mutmut-stats.json

# Launcher build-time artifact (generated by PyInstaller spec from
# backend/pyproject.toml, see launcher/adaptive-learner-launcher.spec).
launcher/adaptive_learner_launcher/_build_info.py

# Coverage (generated by `make test-coverage` or CI)
.coverage
.coverage.*
htmlcov/
coverage.xml
frontend/coverage/

# Environment
.env

# Encrypted credentials (service account keys etc.)
backend/config/plugins/audiobook/google-credentials.enc

# Database
*.db
*.db-shm
*.db-wal
*.db-journal

# Uploads (user assets)
backend/uploads/
# Migration breadcrumbs (written by app.data_dir_migration when it
# moves a v0.25.0-and-earlier subtree into the platformdirs data dir).
# Lives anywhere under backend/ — the existing-but-too-narrow pattern
# missed backend/plugins/installed.migrated-YYYY-MM-DD.
backend/*.migrated-*
backend/**/*.migrated-*

# Production marker (written by FastAPI lifespan startup; see
# backend/app/paths.py + backend/tests/conftest.py).
.adaptive-learner-production

# Dev-only Fernet key (written by `make dev-secret` and sourced by
# `make dev` / `make dev-bg`; see app/services/crypto.py for the
# three-path key-resolution policy). The whole .adaptive-learner/
# subtree is dev scratch space — gitignored as a class so future
# dev-only artefacts (caches, lockfiles, scratch DBs) can land
# here without a separate gitignore entry.
.adaptive-learner/

# MkDocs build output
site/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Docker
adaptive-learner-data/

# Node (frontend)
node_modules/
build/
.next/
frontend/dev-dist/
*.tsbuildinfo

# Temp export files
/tmp/adaptive_learner_*

# Dev PID files
.pid-backend
.pid-frontend

# Config files
/backend/config/backup_history.json
/backend/config/licenses.json
/backend/config/app.yaml

# prompt files
/tmp/todo-prompts.md

# Playwright results
/e2e/test-results/
/e2e/playwright-report/
tmp/

# Claude Code runtime artifacts (per-session lock + scheduled-task state).
# Pre-commit's end-of-file-fixer would otherwise endlessly modify the
# lock file, turning CI red on every push.
/.claude/scheduled_tasks.lock

# Phase 51D — bundled pilot content copied into the Vite build
# at predev / prebuild time. Canonical source is
# docs/explorations/sample-content/. Regenerated via
# frontend/scripts/copy-bundled-content.mjs.
frontend/public/content/

# Coverage reports are generated locally (make test-coverage), never committed.
docs/audits/coverage/
